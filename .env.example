# Salin file ini menjadi `.env` lalu sesuaikan sebelum `docker compose up -d --build`
# cp .env.example .env

# Port HTTP aplikasi (frontend)
APP_PORT=80

# URL publik aplikasi & frontend
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# Debug (jangan true di produksi)
APP_DEBUG=false

# Kosongkan agar APP_KEY di-generate otomatis saat container pertama kali jalan
APP_KEY=

# Database (MySQL otomatis dibuat di volume docker)
DB_DATABASE=db_lab_terpadu
DB_PASSWORD=secret

# Base URL API yang dipakai build frontend (jangan diubah, pakai proxy nginx)
VITE_API_URL=/api

# Render PDF dari .docx via Chromium headless (sudah terpasang di image)
PDF_DOCX_ENABLED=true
PDF_CHROME_PATH=/usr/bin/chromium-browser